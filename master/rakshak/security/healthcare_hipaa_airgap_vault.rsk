// ==============================================================================
// RAKSHAK DEFENSE SUITE - HEALTHCARE & HIPAA AIR-GAP VAULT POLICY
// Language: Rakshak Security Kernel (RSK)
// File: security/healthcare_hipaa_airgap_vault.rsk
// Standard: HIPAA Security Rule 45 CFR Part 164 & HITECH Strict Isolation
// ==============================================================================

shield HealthcareHipaaAirgapVault {
    target: "/ehr/fhir/r4/*", "/dicom/imaging/*", "/patients/v1/phi/*", "/prescriptions/epcs/*";

    hardware {
        require_tpm_2_0: true;
        enforce_pcr_measurements: [0, 7, 11];
        trap_debugger: true;
        zero_memory_on_exit: true;
        protect_process_light_lsass: true;
        require_kernel_dma_protection: true;
    }

    network {
        block_datacenter_asns: true;
        verify_sec_fetch_state: true;
        disallow_third_party_scripts: true;
        require_signed_jwt_claims: true;
        max_sliding_velocity: 8;
    }

    airgap {
        enforce_zero_byte_egress: true;
        quarantine_external_dns: true;
        prohibit_cloud_relay: true;
        disable_remote_telemetry: true;
        local_sqlite_cipher_only: true;
    }

    telemetry {
        min_path_entropy: 3.5;
        require_verified_clinician_biometrics: false;
        require_hardware_webauthn_fido2: true;
        max_token_burst: 20;
    }

    defense {
        mode: HARD_QUARANTINE;
        status_code: 401;
        inject_stego_canary: "HIPAA_AUDIT_HONEY_PATIENT_MRN_991820491";
        adversarial_token_rate: 0.0;
        synthesize_decoy: "ERR_PHI_VAULT_ISOLATED_HARDWARE_EXCEPTION";
    }

    audit {
        etw_kernel_provider: "{C83199B2-5A90-4CEF-A18E-F61391D23A01}";
        syslog_format: RFC_5424_STRUCTURED;
        log_all_phi_access_attempts: true;
    }
}
